          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- إعدادات أوبي المقلوب: العوالم، المراحل، والأرقام

local Config = {}

Config.SaveKey = "FlippedObby_v1"
Config.AutosaveSeconds = 120
Config.JumpPower = 50
Config.LowGravity = 60 -- الجاذبية العادية 196.2
Config.DefaultGravity = 196.2

-- كل عالم له حركة (twist) تتغير فيها اللعبة
Config.Worlds = {
	{
		name = "البداية",
		icon = "🟢",
		desc = "سخّن! نطّ وانتبه من الحمم",
		twist = "none",
		colors = { Color3.fromRGB(110, 205, 120), Color3.fromRGB(80, 170, 235) },
	},
	{
		name = "القمر",
		icon = "🌙",
		desc = "الجاذبية خفيفة… نطّتك صارت طويلة!",
		twist = "lowGravity",
		gapScale = 2.6, -- الفراغات أوسع لأن النطّة أبعد
		colors = { Color3.fromRGB(160, 160, 185), Color3.fromRGB(120, 105, 185) },
	},
	{
		name = "المعكوس",
		icon = "🔄",
		desc = "التحكم معكوس! قدّام يوديك ورا ويمين يوديك يسار",
		twist = "invert",
		colors = { Color3.fromRGB(80, 220, 230), Color3.fromRGB(240, 110, 200) },
	},
	{
		name = "الدنيا مقلوبة",
		icon = "🙃",
		desc = "الكاميرا مقلوبة راس على عقب!",
		twist = "flipCamera",
		colors = { Color3.fromRGB(250, 170, 60), Color3.fromRGB(250, 220, 80) },
	},
	{
		name = "الوقت المعكوس",
		icon = "⏪",
		desc = "المنصات تختفي وترجع… انتبه للتوقيت!",
		twist = "rewind",
		colors = { Color3.fromRGB(195, 155, 105), Color3.fromRGB(150, 115, 85) },
	},
}

-- المراحل: كل مرحلة تبدأ بنقطة حفظ وبعدها عقبات
-- أنواع العقبات: jumps, lava, beam, zigzag, mover, spinner, truss, vanish, pad
Config.Stages = {
	-- 🟢 البداية
	{ world = 1, segments = { { type = "jumps", count = 4, gap = 4 }, { type = "lava", stones = 4 } } },
	{ world = 1, segments = { { type = "beam", length = 14, width = 2 }, { type = "jumps", count = 4, gap = 5, rise = 1 } } },
	{ world = 1, segments = { { type = "mover", span = 18 }, { type = "zigzag", count = 5 } } },
	{ world = 1, segments = { { type = "spinner", radius = 9, speed = 1.4 }, { type = "truss", height = 12 } } },
	-- 🌙 القمر
	{ world = 2, segments = { { type = "jumps", count = 4, gap = 5 }, { type = "jumps", count = 3, gap = 5, rise = 4 } } },
	{ world = 2, segments = { { type = "zigzag", count = 5, gap = 3 }, { type = "beam", length = 20, width = 1.4 } } },
	{ world = 2, segments = { { type = "mover", span = 22, period = 5 }, { type = "lava", stones = 5, gap = 4 } } },
	{ world = 2, segments = { { type = "spinner", radius = 10, speed = 2, bars = 2 }, { type = "jumps", count = 5, gap = 5, size = 4 } } },
	-- 🔄 المعكوس
	{ world = 3, segments = { { type = "jumps", count = 5, gap = 3 }, { type = "beam", length = 12, width = 2.5 } } },
	{ world = 3, segments = { { type = "zigzag", count = 5, gap = 2 }, { type = "lava", stones = 4, gap = 3 } } },
	{ world = 3, segments = { { type = "mover", span = 16 }, { type = "spinner", radius = 9, speed = 1.2 } } },
	{ world = 3, segments = { { type = "beam", length = 18, width = 1.6 }, { type = "truss", height = 14 } } },
	-- 🙃 الدنيا مقلوبة
	{ world = 4, segments = { { type = "jumps", count = 5, gap = 4 }, { type = "lava", stones = 4, gap = 3 } } },
	{ world = 4, segments = { { type = "zigzag", count = 6, gap = 2.5 }, { type = "beam", length = 16, width = 1.8 } } },
	{ world = 4, segments = { { type = "spinner", radius = 9, speed = 1.6 }, { type = "mover", span = 18 } } },
	{ world = 4, segments = { { type = "truss", height = 14 }, { type = "jumps", count = 5, gap = 4, rise = 1 } } },
	-- ⏪ الوقت المعكوس
	{ world = 5, segments = { { type = "vanish", count = 5 }, { type = "jumps", count = 3, gap = 5 } } },
	{ world = 5, segments = { { type = "pad", height = 16 }, { type = "vanish", count = 6 } } },
	{ world = 5, segments = { { type = "mover", span = 18, period = 4 }, { type = "vanish", count = 5 }, { type = "spinner", radius = 9, speed = 2 } } },
	{ world = 5, segments = { { type = "vanish", count = 8, period = 2.8 }, { type = "pad", height = 18 } } },
}

Config.FinalStage = #Config.Stages
Config.FinishedStage = #Config.Stages + 1 -- يعني خلّص الأوبي

-- 🪢 الوضع التعاوني: لاعبين مربوطين بحبل في مسار خاص
Config.Coop = {
	name = "درب الحبل",
	icon = "🪢",
	desc = "انتو مربوطين! لو واحد طاح الثنين يرجعون",
	colors = { Color3.fromRGB(255, 150, 90), Color3.fromRGB(255, 205, 120) },
	courseZ = 320, -- مكان المسار التعاوني (بعيد عن المسار العادي)
	ropeLength = 16, -- طول الحبل العادي
	minRopeLength = 6, -- أقصر طول لما تسحب
	reelSpeed = 10, -- كم ستد بالثانية يقصر لما تسحب
	releaseSpeed = 4, -- كم ستد بالثانية يرجع لطوله
	pullStrength = 10, -- قوة السحب لكل ستد زيادة عن طول الحبل
	maxPull = 45, -- أقصى سرعة سحب
	snapDistance = 60, -- لو أبعد من كذا (مثلاً واحد رسبن) ما نسحب
	pairSeconds = 3, -- كم ثانية توقفون على الدوائر قبل ما تنربطون
	bridgeGap = 10, -- فراغ الجسر (أبعد من النطّة عشان لازم الزر)
	stages = {
		{ segments = { { type = "jumps", count = 4, gap = 4, size = 7 } } },
		{ segments = { { type = "bridge" } } },
		{ segments = { { type = "lanes", length = 36 }, { type = "jumps", count = 3, gap = 4, size = 6 } } },
		{ segments = { { type = "mover", span = 20, size = 9 }, { type = "lava", stones = 4 } } },
		{ segments = { { type = "bridge" }, { type = "spinner", radius = 10, speed = 1.3 } } },
		{ segments = { { type = "lanes", length = 44 }, { type = "jumps", count = 4, gap = 4, size = 6, rise = 1 } } },
		{ segments = { { type = "truss", height = 12, width = 4 }, { type = "bridge" } } },
		{ segments = { { type = "vanish", count = 5, size = 7 }, { type = "jumps", count = 3, gap = 4, size = 7 } } },
	},
}
Config.Coop.FinalStage = #Config.Coop.stages
Config.Coop.FinishedStage = #Config.Coop.stages + 1

function Config.worldIndexForStage(stage: number): number?
	local def = Config.Stages[stage]
	return if def then def.world else nil
end

-- هل هذي المرحلة أول مرحلة في عالمها؟
function Config.isWorldStart(stage: number): boolean
	local def = Config.Stages[stage]
	if not def then
		return false
	end
	local prev = Config.Stages[stage - 1]
	return prev == nil or prev.world ~= def.world
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- تنسيق الوقت: 83.4 ثانية ← 1:23.4

local Format = {}

function Format.time(seconds: number): string
	seconds = math.max(0, seconds)
	local minutes = math.floor(seconds / 60)
	local rest = seconds - minutes * 60
	return string.format("%d:%04.1f", minutes, rest)
end

return Format
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Coop</string>
          <string name="Source"><![CDATA[-- 🪢 الوضع التعاوني: يربط لاعبين بحبل في مسار خاص
-- - دوائر الربط في اللوبي: كل واحد يوقف على دائرة، وبعد 3 ثواني تنربطون
-- - نقطة الحفظ مشتركة، ولو واحد طاح الثنين يرجعون لها
-- - الحبل يسحبه الكلاينت (كل لاعب يتسحب لخويه)، والسيرفر يحدد طوله
-- - الجسور بالأزرار: الجسر يطلع لما أحد يوقف على أحد الأزرار

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))

local CoopConfig = Config.Coop

type Team = {
	a: Player,
	b: Player,
	stage: number,
	length: number,
	publishedLength: number,
	reeling: { [Player]: boolean },
	beam: Beam,
	startTime: number,
	finished: boolean,
	quietUntil: number, -- وقت ما نتجاهل فيه الموت (رسبون مقصود أو موت متسلسل)
}

export type Options = {
	course: any, -- CourseBuilder.CoopCourse
	lobby: any, -- CourseBuilder.Lobby
	remotes: Folder,
	notify: RemoteEvent,
	onCoopWin: (player: Player, elapsed: number) -> number, -- يرجّع عدد مرات الفوز التعاوني
}

local Coop = {}

local teams: { [Player]: Team } = {}
local course
local lobby
local notify: RemoteEvent
local onCoopWin: (Player, number) -> number
local ropes: Folder

local function members(team: Team): { Player }
	return { team.a, team.b }
end

local function other(team: Team, player: Player): Player
	return if team.a == player then team.b else team.a
end

local function aliveRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- هل اللاعب واقف فوق هالقطعة؟ (أضمن من Touched/TouchEnded)
local function standingOn(pad: BasePart, player: Player): boolean
	local root = aliveRoot(player)
	if not root then
		return false
	end
	local rel = pad.CFrame:PointToObjectSpace(root.Position)
	return math.abs(rel.X) <= pad.Size.X / 2 + 0.5 and math.abs(rel.Z) <= pad.Size.Z / 2 + 0.5 and rel.Y > 0 and rel.Y < 6
end

local function ropeAttachment(player: Player): Attachment?
	local root = aliveRoot(player)
	if not root then
		return nil
	end
	local existing = root:FindFirstChild("RopeAttachment")
	if existing and existing:IsA("Attachment") then
		return existing
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "RopeAttachment"
	-- محور الأتاشمنت لتحت عشان الحبل يتدلّى
	attachment.CFrame = CFrame.fromMatrix(Vector3.zero, Vector3.new(0, -1, 0), Vector3.new(1, 0, 0))
	attachment.Parent = root
	return attachment
end

local function updateBeam(team: Team)
	team.beam.Attachment0 = ropeAttachment(team.a)
	team.beam.Attachment1 = ropeAttachment(team.b)
end

local function setTeamAttributes(team: Team)
	for _, player in members(team) do
		player:SetAttribute("Partner", other(team, player).UserId)
		player:SetAttribute("CoopStage", team.stage)
		player:SetAttribute("CoopStart", team.startTime)
		player:SetAttribute("RopeLength", team.length)
	end
end

local function setTeamStage(team: Team, stage: number)
	team.stage = stage
	for _, player in members(team) do
		player:SetAttribute("CoopStage", stage)
	end
end

-- نرجّع الثنين للرسبون (نقطة الحفظ المشتركة) بدون ما نحسبها طيحة
local function respawnTeam(team: Team)
	team.quietUntil = os.clock() + 2
	for _, player in members(team) do
		if player.Parent then
			player:LoadCharacter()
		end
	end
end

local function formTeam(a: Player, b: Player)
	local beam = Instance.new("Beam")
	beam.Name = string.format("Rope_%d_%d", a.UserId, b.UserId)
	beam.Color = ColorSequence.new(Color3.fromRGB(150, 95, 50))
	beam.Width0 = 0.3
	beam.Width1 = 0.3
	beam.FaceCamera = true
	beam.Segments = 12
	beam.LightInfluence = 1
	beam.Parent = ropes

	local team: Team = {
		a = a,
		b = b,
		stage = 1,
		length = CoopConfig.ropeLength,
		publishedLength = CoopConfig.ropeLength,
		reeling = {},
		beam = beam,
		startTime = Workspace:GetServerTimeNow(),
		finished = false,
		quietUntil = 0,
	}
	teams[a] = team
	teams[b] = team
	setTeamAttributes(team)
	for _, player in members(team) do
		notify:FireClient(player, { kind = "coopFormed", partner = other(team, player).DisplayName })
	end
	respawnTeam(team)
end

local function disband(team: Team, reason: string, leaver: Player?)
	if teams[team.a] ~= team and teams[team.b] ~= team then
		return -- انفك من قبل
	end
	team.beam:Destroy()
	for _, player in members(team) do
		teams[player] = nil
		if player ~= leaver and player.Parent then
			player:SetAttribute("Partner", nil)
			player:SetAttribute("CoopStage", nil)
			player:SetAttribute("CoopStart", nil)
			player:SetAttribute("RopeLength", nil)
			notify:FireClient(player, { kind = "coopBroken", text = reason })
			player:LoadCharacter() -- يرجع لمرحلته في الأوبي العادي
		end
	end
end

function Coop.isTeamed(player: Player): boolean
	return teams[player] ~= nil
end

-- مكان الرسبون: نقطة الحفظ المشتركة، وكل واحد على جنب
function Coop.spawnCFrame(player: Player): CFrame?
	local team = teams[player]
	if not team then
		return nil
	end
	local base = if team.stage > CoopConfig.FinalStage then course.finishSpawn else course.checkpoints[team.stage]
	local side = if team.a == player then -2.5 else 2.5
	return base * CFrame.new(side, 0, 0)
end

function Coop.onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	if character:WaitForChild("HumanoidRootPart", 10) then
		local team = teams[player]
		if team then
			updateBeam(team)
		end
	end

	humanoid.Died:Connect(function()
		local team = teams[player]
		-- نتأكد إنها الشخصية الحالية وإن الموت مو بسبب رسبون مقصود
		if not team or player.Character ~= character or os.clock() < team.quietUntil then
			return
		end
		team.quietUntil = os.clock() + 2
		local partner = other(team, player)
		local partnerCharacter = partner.Character
		local partnerHumanoid = partnerCharacter and partnerCharacter:FindFirstChildOfClass("Humanoid")
		if partnerHumanoid and partnerHumanoid.Health > 0 then
			partnerHumanoid.Health = 0
		end
		notify:FireClient(partner, { kind = "coopFall", name = player.DisplayName })
		notify:FireClient(player, { kind = "coopFall", name = player.DisplayName, self = true })
	end)
end

function Coop.onPlayerRemoving(player: Player)
	local team = teams[player]
	if team then
		disband(team, string.format("✂️ %s طلع من اللعبة، وانفك الحبل", player.DisplayName), player)
	end
end

-- ========== حلقات السيرفر ==========

local pairing: { a: Player?, b: Player?, since: number } = { a = nil, b = nil, since = 0 }

local function pairStep()
	local pads = lobby.pairPads
	local onA: Player? = nil
	local onB: Player? = nil
	for _, player in Players:GetPlayers() do
		if not teams[player] then
			if not onA and standingOn(pads[1], player) then
				onA = player
			elseif not onB and standingOn(pads[2], player) then
				onB = player
			end
		end
	end

	local status = lobby.pairStatus
	if onA and onB and onA ~= onB then
		if pairing.a ~= onA or pairing.b ~= onB then
			pairing.a, pairing.b, pairing.since = onA, onB, os.clock()
		end
		local left = CoopConfig.pairSeconds - (os.clock() - pairing.since)
		if left <= 0 then
			pairing.a, pairing.b = nil, nil
			status.Text = ""
			formTeam(onA, onB)
		else
			status.Text = string.format("🪢 تنربطون بعد %d…", math.ceil(left))
		end
	else
		pairing.a, pairing.b = nil, nil
		if onA or onB then
			status.Text = "🪢 ننتظر خويك يوقف على الدائرة الثانية"
		else
			status.Text = ""
		end
	end
end

local function bridgeStep()
	for _, group in course.bridges do
		local active = false
		for _, plate in group.plates do
			for _, player in Players:GetPlayers() do
				if standingOn(plate, player) then
					active = true
					break
				end
			end
			if active then
				break
			end
		end
		local bridge: BasePart = group.bridge
		if bridge.CanCollide ~= active then
			bridge.CanCollide = active
			bridge.Transparency = if active then 0.1 else 0.85
			for _, plate in group.plates do
				plate.Material = if active then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
end

local function ropeStep(dt: number)
	local seen: { [Team]: boolean } = {}
	for _, team in teams do
		if not seen[team] then
			seen[team] = true
			local reeling = team.reeling[team.a] or team.reeling[team.b]
			if reeling then
				team.length = math.max(CoopConfig.minRopeLength, team.length - CoopConfig.reelSpeed * dt)
			else
				team.length = math.min(CoopConfig.ropeLength, team.length + CoopConfig.releaseSpeed * dt)
			end
			local atLimit = team.length == CoopConfig.minRopeLength or team.length == CoopConfig.ropeLength
			if math.abs(team.length - team.publishedLength) >= 0.25 or (atLimit and team.length ~= team.publishedLength) then
				team.publishedLength = team.length
				for _, player in members(team) do
					player:SetAttribute("RopeLength", team.length)
				end
			end
		end
	end
end

-- ========== البداية ==========

function Coop.init(options: Options)
	course = options.course
	lobby = options.lobby
	notify = options.notify
	onCoopWin = options.onCoopWin

	ropes = Instance.new("Folder")
	ropes.Name = "Ropes"
	ropes.Parent = Workspace

	local function remote(name: string): RemoteEvent
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = options.remotes
		return r
	end
	local reelRemote = remote("CoopReel")
	local leaveRemote = remote("CoopLeave")
	local restartRemote = remote("CoopRestart")

	reelRemote.OnServerEvent:Connect(function(player, holding)
		local team = teams[player]
		if team then
			team.reeling[player] = holding == true
		end
	end)

	leaveRemote.OnServerEvent:Connect(function(player)
		local team = teams[player]
		if team then
			disband(team, string.format("✂️ %s فك الحبل", player.DisplayName))
		end
	end)

	local lastRestart: { [Team]: number } = {}
	restartRemote.OnServerEvent:Connect(function(player)
		local team = teams[player]
		if not team then
			return
		end
		local now = os.clock()
		if lastRestart[team] and now - lastRestart[team] < 2 then
			return
		end
		lastRestart[team] = now
		team.finished = false
		team.startTime = Workspace:GetServerTimeNow()
		team.stage = 1
		setTeamAttributes(team)
		respawnTeam(team)
	end)

	-- نقاط الحفظ المشتركة
	for stage, pad in course.checkpointPads do
		pad.Touched:Connect(function(hit)
			local model = hit:FindFirstAncestorOfClass("Model")
			local player = model and Players:GetPlayerFromCharacter(model)
			local team = player and teams[player]
			if team and not team.finished and stage > team.stage then
				setTeamStage(team, stage)
			end
		end)
	end

	-- النهاية
	course.finishPad.Touched:Connect(function(hit)
		local model = hit:FindFirstAncestorOfClass("Model")
		local player = model and Players:GetPlayerFromCharacter(model)
		local team = player and teams[player]
		if not team or team.finished or team.stage ~= CoopConfig.FinalStage then
			return
		end
		team.finished = true
		setTeamStage(team, CoopConfig.FinishedStage)
		local elapsed = Workspace:GetServerTimeNow() - team.startTime
		for _, member in members(team) do
			local wins = onCoopWin(member, elapsed)
			notify:FireClient(member, {
				kind = "coopWin",
				time = elapsed,
				wins = wins,
				partner = other(team, member).DisplayName,
			})
		end
		local text = string.format(
			"🪢🏆 %s و %s خلّصوا درب الحبل بوقت %s!",
			team.a.DisplayName,
			team.b.DisplayName,
			Format.time(elapsed)
		)
		for _, viewer in Players:GetPlayers() do
			if teams[viewer] ~= team then
				notify:FireClient(viewer, { kind = "message", text = text })
			end
		end
	end)

	local pairTimer = 0
	local bridgeTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		ropeStep(dt)
		pairTimer += dt
		if pairTimer >= 0.25 then
			pairTimer = 0
			pairStep()
		end
		bridgeTimer += dt
		if bridgeTimer >= 0.1 then
			bridgeTimer = 0
			bridgeStep()
		end
	end)

	-- نبدأ الجسور مسكّرة
	bridgeStep()
end

return Coop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">CourseBuilder</string>
          <string name="Source"><![CDATA[-- يبني الأوبي كامل بالكود: اللوبي، المراحل، نقاط الحفظ، النهاية، والمسار التعاوني 🪢
-- الأشياء اللي تتحرك (منصات، مراوح، منصات تختفي) يحرّكها الكلاينت عشان تكون ناعمة

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local CourseBuilder = {}

local START_Y = 12
local THICK = 2 -- سماكة المنصات
local LAVA_COLOR = Color3.fromRGB(255, 85, 30)
local BEAM_COLOR = Color3.fromRGB(150, 100, 60)
local MOVER_COLOR = Color3.fromRGB(240, 240, 255)
local CHECKPOINT_COLOR = Color3.fromRGB(235, 235, 235)
local PAD_COLOR = Color3.fromRGB(60, 255, 120)
local STONE_COLOR = Color3.fromRGB(70, 70, 82)
local PLATE_COLOR = Color3.fromRGB(255, 90, 160)
local BRIDGE_COLOR = Color3.fromRGB(255, 200, 230)

-- جسر يطلع لما أحد يوقف على أحد الأزرار
export type BridgeGroup = {
	plates: { BasePart },
	bridge: BasePart,
}

type Ctx = {
	x: number, -- نهاية آخر منصة (على محور x)
	y: number, -- سطح آخر منصة
	z: number, -- وسط المسار (على محور z)
	folder: Instance,
	gapScale: number,
	colors: { Color3 },
	count: number,
	bridges: { BridgeGroup },
}

local function makePart(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function scaled(ctx: Ctx, gap: number): number
	return gap * ctx.gapScale
end

type PlatformOpts = {
	gap: number?,
	rise: number?,
	z: number?, -- إزاحة عن وسط المسار
	color: Color3?,
	material: Enum.Material?,
}

-- منصة تبدأ بعد آخر منصة بمسافة gap، وتصير هي "آخر منصة"
local function platform(ctx: Ctx, length: number, width: number, opts: PlatformOpts?): Part
	local o: PlatformOpts = opts or {}
	local nearX = ctx.x + (o.gap or 0)
	local top = ctx.y + (o.rise or 0)
	ctx.count += 1
	local color = o.color or ctx.colors[ctx.count % #ctx.colors + 1]
	local p = makePart(
		ctx.folder,
		Vector3.new(length, THICK, width),
		CFrame.new(nearX + length / 2, top - THICK / 2, ctx.z + (o.z or 0)),
		color,
		o.material
	)
	ctx.x = nearX + length
	ctx.y = top
	return p
end

local function addLabel(
	adornee: BasePart,
	text: string,
	size: UDim2,
	offsetY: number,
	color: Color3,
	maxDistance: number?
): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance or 120
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = adornee
	return label
end

-- قطعة مخفية نعلّق عليها لوحة كلام
local function signAnchor(parent: Instance, position: Vector3): Part
	local anchor = makePart(parent, Vector3.new(1, 1, 1), CFrame.new(position), Color3.new(1, 1, 1))
	anchor.Name = "Sign"
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	return anchor
end

local Segments = {}

-- نطّات عادية
function Segments.jumps(ctx: Ctx, s)
	local size = s.size or 5
	for i = 1, s.count or 4 do
		platform(ctx, size, size, {
			gap = scaled(ctx, s.gap or 4),
			rise = s.rise or 0,
			z = math.sin(i * 1.7) * 2,
		})
	end
	local landing = math.max(6, size)
	platform(ctx, landing, landing, { gap = scaled(ctx, s.gap or 4) })
end

-- حمم وحجار تنط عليها
function Segments.lava(ctx: Ctx, s)
	local startX = ctx.x
	local baseY = ctx.y
	local gap = scaled(ctx, s.gap or 3)
	for i = 1, s.stones or 4 do
		platform(ctx, 3, 3, {
			gap = gap,
			z = if i % 2 == 0 then 2 else -2,
			color = STONE_COLOR,
			material = Enum.Material.Slate,
		})
	end
	local endX = ctx.x + gap
	local lava = makePart(
		ctx.folder,
		Vector3.new(endX - startX, 1, 16),
		CFrame.new((startX + endX) / 2, baseY - THICK - 0.5, ctx.z),
		LAVA_COLOR,
		Enum.Material.Neon
	)
	lava.Name = "Lava"
	CollectionService:AddTag(lava, "Kill")
	platform(ctx, 6, 8, { gap = gap })
end

-- خشبة رفيعة تمشي عليها
function Segments.beam(ctx: Ctx, s)
	platform(ctx, s.length or 14, s.width or 1.5, { color = BEAM_COLOR, material = Enum.Material.WoodPlanks })
	platform(ctx, 6, 6)
end

-- منصات يمين ويسار
function Segments.zigzag(ctx: Ctx, s)
	local gap = scaled(ctx, s.gap or 2.5)
	for i = 1, s.count or 5 do
		platform(ctx, 4, 4, { gap = gap, z = if i % 2 == 0 then 4 else -4 })
	end
	platform(ctx, 6, 6, { gap = gap })
end

-- منصة تروح وترجع فوق فراغ
function Segments.mover(ctx: Ctx, s)
	local span = s.span or 18
	local size = s.size or 6
	local startCenter = ctx.x + size / 2 + 0.5
	local endCenter = ctx.x + span - size / 2 - 0.5
	local origin = CFrame.new(startCenter, ctx.y - THICK / 2, ctx.z)
	local p = makePart(ctx.folder, Vector3.new(size, THICK, size), origin, MOVER_COLOR, Enum.Material.DiamondPlate)
	p.Name = "Mover"
	p:SetAttribute("Origin", origin)
	p:SetAttribute("Offset", Vector3.new(endCenter - startCenter, 0, 0))
	p:SetAttribute("Period", s.period or 6)
	CollectionService:AddTag(p, "Mover")
	ctx.x += span
	platform(ctx, math.max(6, size), 8)
end

-- دائرة فوقها عصا حمرا تدور، نطّ فوقها
function Segments.spinner(ctx: Ctx, s)
	local r = s.radius or 9
	local gap = scaled(ctx, 3)
	local cx = ctx.x + gap + r
	local top = ctx.y
	ctx.count += 1
	local disk = makePart(
		ctx.folder,
		Vector3.new(THICK, r * 2, r * 2),
		CFrame.new(cx, top - THICK / 2, ctx.z) * CFrame.Angles(0, 0, math.pi / 2),
		ctx.colors[ctx.count % #ctx.colors + 1]
	)
	disk.Shape = Enum.PartType.Cylinder
	local bars = s.bars or 1
	for b = 1, bars do
		local center = CFrame.new(cx, top + 1.2, ctx.z)
		local bar = makePart(ctx.folder, Vector3.new(r * 2 - 0.5, 1, 1), center, LAVA_COLOR, Enum.Material.Neon)
		bar.Name = "SpinnerBar"
		bar.CanCollide = false
		bar:SetAttribute("Center", center)
		bar:SetAttribute("Speed", s.speed or 1.5)
		bar:SetAttribute("Phase", (b - 1) * math.pi / bars)
		CollectionService:AddTag(bar, "Kill")
		CollectionService:AddTag(bar, "Spinner")
	end
	ctx.x = cx + r
	ctx.y = top
	platform(ctx, 6, 6, { gap = gap })
end

-- سلّم تتسلقه لفوق
function Segments.truss(ctx: Ctx, s)
	local h = s.height or 12
	h -= h % 2 -- لازم يكون زوجي
	local w = s.width or 2
	w -= w % 2
	platform(ctx, 6, math.max(6, w + 2), { gap = scaled(ctx, 4) })
	local truss = Instance.new("TrussPart")
	truss.Anchored = true
	truss.Size = Vector3.new(2, h, w)
	truss.CFrame = CFrame.new(ctx.x + 1, ctx.y + h / 2, ctx.z)
	truss.Color = Color3.fromRGB(90, 90, 100)
	truss.Parent = ctx.folder
	ctx.x += 2
	platform(ctx, 8, 8, { rise = h })
end

-- منصات تختفي وترجع (مجموعتين بالتناوب)
function Segments.vanish(ctx: Ctx, s)
	local period = s.period or 3.2
	local gap = scaled(ctx, s.gap or 3.5)
	local size = s.size or 5
	for i = 1, s.count or 6 do
		local p = platform(ctx, size, size, {
			gap = gap,
			color = if i % 2 == 0 then Color3.fromRGB(120, 200, 255) else Color3.fromRGB(255, 160, 220),
			material = Enum.Material.Glass,
		})
		p.Name = "Vanish"
		p:SetAttribute("Period", period)
		p:SetAttribute("Offset", if i % 2 == 0 then period / 2 else 0)
		p:SetAttribute("Visible", 0.72)
		CollectionService:AddTag(p, "Vanish")
	end
	platform(ctx, 6, 8, { gap = gap })
end

-- منصة قفز خارق توديك لفوق
function Segments.pad(ctx: Ctx, s)
	local h = s.height or 16
	platform(ctx, 8, 8, { gap = scaled(ctx, 4) })
	local pad = makePart(ctx.folder, Vector3.new(4, 0.4, 4), CFrame.new(ctx.x - 3, ctx.y + 0.2, ctx.z), PAD_COLOR, Enum.Material.Neon)
	pad.Name = "JumpPad"
	pad:SetAttribute("LaunchHeight", h + 9)
	CollectionService:AddTag(pad, "JumpPad")
	addLabel(pad, "⬆️", UDim2.fromOffset(60, 60), 3, PAD_COLOR, 60)
	platform(ctx, 8, 8, { gap = 4, rise = h })
end

-- 🪢 جسر بأزرار: واحد يوقف على الزر عشان يطلع الجسر، والثاني يعبر
-- الفراغ أبعد من النطّة، والأزرار قريبة من الحافة عشان الحبل يكفي بينهم
function Segments.bridge(ctx: Ctx, s)
	local gap = s.gap or Config.Coop.bridgeGap
	local plateZ = ctx.z - 3.5
	local bridgeZ = 3

	platform(ctx, 10, 12, { gap = scaled(ctx, 4) })
	local nearPlate = makePart(ctx.folder, Vector3.new(4, 0.3, 4), CFrame.new(ctx.x - 2, ctx.y + 0.15, plateZ), PLATE_COLOR)
	nearPlate.Name = "BridgePlate"
	addLabel(nearPlate, "🔘 وقّف هنا", UDim2.fromOffset(140, 40), 3, PLATE_COLOR, 80)

	local bridge = makePart(
		ctx.folder,
		Vector3.new(gap, THICK, 4),
		CFrame.new(ctx.x + gap / 2, ctx.y - THICK / 2, ctx.z + bridgeZ),
		BRIDGE_COLOR,
		Enum.Material.Glass
	)
	bridge.Name = "Bridge"
	bridge.CanCollide = false
	bridge.Transparency = 0.85
	CollectionService:AddTag(bridge, "CoopBridge")

	ctx.x += gap
	platform(ctx, 10, 12)
	local farPlate = makePart(
		ctx.folder,
		Vector3.new(4, 0.3, 4),
		CFrame.new(ctx.x - 10 + 2, ctx.y + 0.15, plateZ),
		PLATE_COLOR
	)
	farPlate.Name = "BridgePlate"
	addLabel(farPlate, "🔘 وقّف هنا", UDim2.fromOffset(140, 40), 3, PLATE_COLOR, 80)

	table.insert(ctx.bridges, { plates = { nearPlate, farPlate }, bridge = bridge })
end

-- 🪢 طريقين ضيقين وبينهم حمم: كل واحد ياخذ طريق، والفراغات بأماكن مختلفة
function Segments.lanes(ctx: Ctx, s)
	local length = s.length or 36
	platform(ctx, 6, 14, { gap = scaled(ctx, 3) })
	local startX = ctx.x + 3
	local endX = startX + length
	local baseY = ctx.y
	local laneZ = 5

	local function lane(z: number, pieceLength: number, gap: number, phase: number)
		local x = startX + phase
		while x < endX do
			local l = math.min(pieceLength, endX - x)
			if l >= 1.5 then
				ctx.count += 1
				makePart(
					ctx.folder,
					Vector3.new(l, THICK, 2.5),
					CFrame.new(x + l / 2, baseY - THICK / 2, ctx.z + z),
					ctx.colors[ctx.count % #ctx.colors + 1]
				)
			end
			x += l + gap
		end
	end
	-- أول قطعة لاصقة بالمنصة عشان تبدون منها
	lane(-laneZ, 5, 3, -3)
	lane(laneZ, 3.5, 3, -3)

	local divider = makePart(
		ctx.folder,
		Vector3.new(length + 3, 1, 4),
		CFrame.new(startX - 3 + (length + 3) / 2, baseY - 1.5, ctx.z),
		LAVA_COLOR,
		Enum.Material.Neon
	)
	divider.Name = "LaneLava"
	CollectionService:AddTag(divider, "Kill")

	ctx.x = endX
	ctx.y = baseY
	platform(ctx, 8, 14, { gap = 3 })
end

type CheckpointOpts = {
	tag: string,
	width: number,
}

local function buildCheckpoint(ctx: Ctx, stage: number, gap: number, opts: CheckpointOpts): (BasePart, CFrame)
	local plat = platform(ctx, 10, opts.width, { gap = gap, color = Color3.fromRGB(60, 60, 70), material = Enum.Material.Concrete })
	local pad = makePart(
		ctx.folder,
		Vector3.new(7, 0.3, 7),
		plat.CFrame * CFrame.new(0, THICK / 2 + 0.15, 0),
		CHECKPOINT_COLOR,
		Enum.Material.Neon
	)
	pad.Name = "Checkpoint"
	pad:SetAttribute("Stage", stage)
	CollectionService:AddTag(pad, opts.tag)
	addLabel(pad, tostring(stage), UDim2.fromOffset(80, 80), 5, Color3.new(1, 1, 1))
	-- مكان الرسبون فوق النقطة ووجهك للمرحلة
	local spawnCf = CFrame.lookAt(pad.Position + Vector3.new(0, 4, 0), pad.Position + Vector3.new(10, 4, 0))
	return pad, spawnCf
end

local function buildWorldSign(parent: Instance, position: Vector3, title: string, desc: string, color: Color3)
	addLabel(signAnchor(parent, position), title, UDim2.fromOffset(420, 70), 0, color, 200)
	addLabel(signAnchor(parent, position - Vector3.new(0, 4, 0)), desc, UDim2.fromOffset(420, 40), 0, Color3.new(1, 1, 1), 200)
end

export type Lobby = {
	spawn: SpawnLocation,
	pairPads: { BasePart },
	pairStatus: TextLabel,
}

local function buildLobby(root: Instance, ctx: Ctx): Lobby
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = root
	ctx.folder = lobby
	ctx.x = -44
	local floor = platform(ctx, 44, 44, { color = Color3.fromRGB(95, 95, 110), material = Enum.Material.Concrete })

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(floor.Position.X - 10, ctx.y + 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 200, 60)
	spawn.Material = Enum.Material.Neon
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby

	-- لوحة العنوان
	addLabel(signAnchor(lobby, Vector3.new(floor.Position.X, ctx.y + 16, 0)), "🙃 أوبي المقلوب", UDim2.fromOffset(500, 100), 0, Color3.fromRGB(255, 220, 80), 300)
	addLabel(
		signAnchor(lobby, Vector3.new(floor.Position.X, ctx.y + 10, 0)),
		"5 عوالم وكل عالم يقلب اللعبة! ← روح يمين وابدأ",
		UDim2.fromOffset(480, 40),
		0,
		Color3.new(1, 1, 1),
		300
	)

	-- أعمدة زينة
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		local pos = floor.Position + Vector3.new(math.cos(angle) * 18, THICK / 2 + 5, math.sin(angle) * 18)
		local pillar = makePart(lobby, Vector3.new(2, 10, 2), CFrame.new(pos), Color3.fromRGB(255, 200, 60), Enum.Material.Neon)
		pillar.Name = "Pillar"
	end

	-- 🪢 دوائر الربط: كل لاعب يوقف على دائرة
	local pairZ = 14
	local pairPads = {}
	for i, offsetX in { -4, 4 } do
		local pad = makePart(
			lobby,
			Vector3.new(5, 0.4, 5),
			CFrame.new(floor.Position.X - 8 + offsetX, ctx.y + 0.2, pairZ),
			if i == 1 then Color3.fromRGB(255, 150, 90) else Color3.fromRGB(255, 205, 120),
			Enum.Material.Neon
		)
		pad.Name = "PairPad" .. i
		pad.Shape = Enum.PartType.Block
		addLabel(pad, "🪢 " .. i, UDim2.fromOffset(70, 50), 3, Color3.new(1, 1, 1), 80)
		pairPads[i] = pad
	end
	addLabel(
		signAnchor(lobby, Vector3.new(floor.Position.X - 8, ctx.y + 10, pairZ)),
		"🪢 العب مع خوي: كل واحد يوقف على دائرة",
		UDim2.fromOffset(380, 40),
		0,
		Config.Coop.colors[2],
		120
	)
	local pairStatus = addLabel(
		signAnchor(lobby, Vector3.new(floor.Position.X - 8, ctx.y + 7, pairZ)),
		"",
		UDim2.fromOffset(380, 34),
		0,
		Color3.new(1, 1, 1),
		120
	)

	return { spawn = spawn, pairPads = pairPads, pairStatus = pairStatus }
end

type FinishOpts = {
	name: string,
	tag: string,
	text: string,
}

local function buildFinish(root: Instance, ctx: Ctx, opts: FinishOpts): (BasePart, CFrame)
	local folder = Instance.new("Folder")
	folder.Name = opts.name
	folder.Parent = root
	ctx.folder = folder
	local floor = platform(ctx, 24, 24, { gap = 4, color = Color3.fromRGB(255, 215, 80), material = Enum.Material.Marble })

	local base = makePart(folder, Vector3.new(6, 3, 6), floor.CFrame * CFrame.new(4, THICK / 2 + 1.5, 0), Color3.fromRGB(60, 60, 70), Enum.Material.Marble)
	base.Name = "TrophyBase"
	local cup = makePart(
		folder,
		Vector3.new(3, 5, 3),
		base.CFrame * CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(255, 200, 40),
		Enum.Material.Foil
	)
	cup.Name = "Trophy"
	cup.Shape = Enum.PartType.Cylinder
	addLabel(cup, opts.text, UDim2.fromOffset(260, 70), 5, Color3.fromRGB(255, 220, 80), 200)

	local pad = makePart(folder, Vector3.new(16, 0.3, 16), floor.CFrame * CFrame.new(-2, THICK / 2 + 0.15, 0), Color3.fromRGB(255, 240, 150), Enum.Material.Neon)
	pad.Name = "FinishPad"
	CollectionService:AddTag(pad, opts.tag)

	local spawnCf = CFrame.lookAt(floor.Position + Vector3.new(-6, 5, 0), floor.Position + Vector3.new(10, 5, 0))
	return pad, spawnCf
end

-- بحر حمم تحت المسار كامل
local function buildLavaSea(root: Instance, fromX: number, toX: number, z: number, width: number)
	local chunk = 512
	local x = fromX
	while x < toX do
		local len = math.min(chunk, toX - x)
		local sea = makePart(root, Vector3.new(len, 1, width), CFrame.new(x + len / 2, 0, z), LAVA_COLOR, Enum.Material.Neon)
		sea.Name = "LavaSea"
		sea.Transparency = 0.15
		CollectionService:AddTag(sea, "Kill")
		x += len
	end
end

local function runSegments(ctx: Ctx, segments)
	for _, segment in segments do
		local build = Segments[segment.type]
		if build then
			build(ctx, segment)
		else
			warn("نوع عقبة غير معروف:", segment.type)
		end
	end
end

export type CoopCourse = {
	checkpoints: { CFrame },
	checkpointPads: { BasePart },
	finishPad: BasePart,
	finishSpawn: CFrame,
	bridges: { BridgeGroup },
}

local function buildCoopCourse(root: Instance): CoopCourse
	local coopRoot = Instance.new("Folder")
	coopRoot.Name = "Coop"
	coopRoot.Parent = root

	local ctx: Ctx = {
		x = 0,
		y = START_Y,
		z = Config.Coop.courseZ,
		folder = coopRoot,
		gapScale = 1,
		colors = Config.Coop.colors,
		count = 0,
		bridges = {},
	}

	local checkpoints = {}
	local checkpointPads = {}
	for stage, def in Config.Coop.stages do
		local folder = Instance.new("Folder")
		folder.Name = string.format("CoopStage%02d", stage)
		folder.Parent = coopRoot
		ctx.folder = folder
		local gap = if stage == 1 then 0 else 4
		checkpointPads[stage], checkpoints[stage] = buildCheckpoint(ctx, stage, gap, { tag = "CoopCheckpoint", width = 12 })
		if stage == 1 then
			buildWorldSign(
				folder,
				Vector3.new(ctx.x - 5, ctx.y + 14, ctx.z),
				Config.Coop.icon .. " " .. Config.Coop.name,
				Config.Coop.desc,
				Config.Coop.colors[1]
			)
		end
		runSegments(ctx, def.segments)
	end

	local finishPad, finishSpawn = buildFinish(coopRoot, ctx, { name = "CoopFinish", tag = "CoopFinish", text = "🪢🏆 خلّصتوا!" })
	buildLavaSea(coopRoot, -40, ctx.x + 60, ctx.z, 160)

	return {
		checkpoints = checkpoints,
		checkpointPads = checkpointPads,
		finishPad = finishPad,
		finishSpawn = finishSpawn,
		bridges = ctx.bridges,
	}
end

export type Course = {
	lobby: Lobby,
	checkpoints: { CFrame },
	checkpointPads: { BasePart },
	finishPad: BasePart,
	finishSpawn: CFrame,
	coop: CoopCourse,
}

function CourseBuilder.build(): Course
	local root = Instance.new("Folder")
	root.Name = "Course"
	root.Parent = Workspace

	local ctx: Ctx = {
		x = 0,
		y = START_Y,
		z = 0,
		folder = root,
		gapScale = 1,
		colors = Config.Worlds[1].colors,
		count = 0,
		bridges = {},
	}

	local lobby = buildLobby(root, ctx)
	local checkpoints = {}
	local checkpointPads = {}

	for stage, def in Config.Stages do
		local folder = Instance.new("Folder")
		folder.Name = string.format("Stage%02d", stage)
		folder.Parent = root
		ctx.folder = folder

		-- الفراغ قبل نقطة الحفظ يتبع العالم اللي قبلها (لأن اللاعب لسا فيه)
		local gap = if stage == 1 then 0 else scaled(ctx, 4)
		checkpointPads[stage], checkpoints[stage] = buildCheckpoint(ctx, stage, gap, { tag = "Checkpoint", width = 10 })

		local world = Config.Worlds[def.world]
		ctx.gapScale = world.gapScale or 1
		ctx.colors = world.colors
		if Config.isWorldStart(stage) then
			buildWorldSign(
				folder,
				Vector3.new(ctx.x - 5, ctx.y + 14, 0),
				string.format("%s العالم %d: %s", world.icon, def.world, world.name),
				world.desc,
				world.colors[1]
			)
		end

		runSegments(ctx, def.segments)
	end

	local finishPad, finishSpawn = buildFinish(root, ctx, { name = "Finish", tag = "Finish", text = "🏆 النهاية!" })
	buildLavaSea(root, -80, ctx.x + 60, 0, 400)

	return {
		lobby = lobby,
		checkpoints = checkpoints,
		checkpointPads = checkpointPads,
		finishPad = finishPad,
		finishSpawn = finishSpawn,
		coop = buildCoopCourse(root),
	}
end

return CourseBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[-- حفظ وتحميل تقدّم اللاعب (المرحلة، عدد مرات الفوز، أفضل وقت، والفوز التعاوني)
-- لو اللعبة مو منشورة أو الـ API مقفّل في Studio، اللعبة تشتغل عادي بس ما تحفظ

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

export type Profile = {
	stage: number,
	wins: number,
	best: number?,
	coopWins: number,
}

local Data = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.SaveKey)
	end)
	if ok then
		store = result
	else
		warn("[Data] الحفظ مقفّل:", result)
	end
end

local function key(userId: number): string
	return "player_" .. userId
end

function Data.default(): Profile
	return { stage = 1, wins = 0, best = nil, coopWins = 0 }
end

function Data.load(userId: number): Profile
	local profile = Data.default()
	if not store then
		return profile
	end
	local ok, result = pcall(function()
		return store:GetAsync(key(userId))
	end)
	if not ok then
		warn("[Data] ما قدرت أحمّل:", result)
		return profile
	end
	if type(result) == "table" then
		profile.stage = math.clamp(tonumber(result.stage) or 1, 1, Config.FinishedStage)
		profile.wins = tonumber(result.wins) or 0
		profile.best = tonumber(result.best)
		profile.coopWins = tonumber(result.coopWins) or 0
	end
	return profile
end

function Data.save(userId: number, profile: Profile)
	if not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(userId), {
			stage = profile.stage,
			wins = profile.wins,
			best = profile.best,
			coopWins = profile.coopWins,
		})
	end)
	if not ok then
		warn("[Data] ما قدرت أحفظ:", err)
	end
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- السيرفر: يبني الأوبي، يتابع نقاط الحفظ والفوز، ويحفظ التقدّم
-- (الوضع التعاوني 🪢 في Coop.luau)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))
local CourseBuilder = require(script.Parent:WaitForChild("CourseBuilder"))
local Data = require(script.Parent:WaitForChild("Data"))
local Coop = require(script.Parent:WaitForChild("Coop"))

-- إعدادات عامة
StarterPlayer.CharacterUseJumpPower = true
StarterPlayer.CharacterJumpPower = Config.JumpPower
Workspace.Gravity = Config.DefaultGravity
Players.RespawnTime = 1.5 -- رجعة سريعة بعد الطيحة
Lighting.ClockTime = 14
Lighting.Brightness = 2
Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)
if not Lighting:FindFirstChildOfClass("Atmosphere") then
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Haze = 1
	atmosphere.Color = Color3.fromRGB(200, 215, 255)
	atmosphere.Parent = Lighting
end

local course = CourseBuilder.build()

-- قنوات التواصل مع الكلاينت
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local restartRemote = Instance.new("RemoteEvent")
restartRemote.Name = "Restart"
restartRemote.Parent = remotes
local notifyRemote = Instance.new("RemoteEvent")
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes

local profiles: { [Player]: Data.Profile } = {}

-- أسماء الأعمدة في لوحة اللاعبين
local STAGE_STAT = "المرحلة"
local WINS_STAT = "الفوز"
local COOP_STAT = "🪢"

Coop.init({
	course = course.coop,
	lobby = course.lobby,
	remotes = remotes,
	notify = notifyRemote,
	onCoopWin = function(player: Player, _elapsed: number): number
		local profile = profiles[player]
		if not profile then
			return 0
		end
		profile.coopWins += 1
		player:SetAttribute("CoopWins", profile.coopWins)
		local stats = player:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild(COOP_STAT)
		if value and value:IsA("IntValue") then
			value.Value = profile.coopWins
		end
		return profile.coopWins
	end,
})
remotes.Parent = ReplicatedStorage

local function stageText(stage: number): string
	return if stage >= Config.FinishedStage then "🏆" else tostring(stage)
end

local function setStage(player: Player, stage: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.stage = stage
	player:SetAttribute("Stage", stage)
	local stats = player:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild(STAGE_STAT)
	if value and value:IsA("StringValue") then
		value.Value = stageText(stage)
	end
end

local function startRun(player: Player, fullRun: boolean)
	player:SetAttribute("RunStart", Workspace:GetServerTimeNow())
	player:SetAttribute("FullRun", fullRun)
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model or not model:FindFirstChildOfClass("Humanoid") then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

local function spawnCFrame(stage: number): CFrame?
	if stage >= Config.FinishedStage then
		return course.finishSpawn
	elseif stage > 1 then
		return course.checkpoints[stage]
	end
	return nil -- المرحلة الأولى: يطلع من اللوبي
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = Config.JumpPower
	end
	task.spawn(Coop.onCharacterAdded, player, character)
	local profile = profiles[player]
	local cf = Coop.spawnCFrame(player) or spawnCFrame(if profile then profile.stage else 1)
	if cf and character:WaitForChild("HumanoidRootPart", 10) then
		task.wait() -- نخلي الشخصية تكمّل تحميل قبل النقل
		character:PivotTo(cf)
	end
end

local function onPlayerAdded(player: Player)
	local profile = Data.load(player.UserId)
	if not player.Parent then
		return -- طلع قبل ما نخلص
	end
	profiles[player] = profile

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local stageValue = Instance.new("StringValue")
	stageValue.Name = STAGE_STAT
	stageValue.Parent = stats
	local winsValue = Instance.new("IntValue")
	winsValue.Name = WINS_STAT
	winsValue.Value = profile.wins
	winsValue.Parent = stats
	local coopValue = Instance.new("IntValue")
	coopValue.Name = COOP_STAT
	coopValue.Value = profile.coopWins
	coopValue.Parent = stats
	stats.Parent = player

	player:SetAttribute("Wins", profile.wins)
	player:SetAttribute("BestTime", profile.best)
	player:SetAttribute("CoopWins", profile.coopWins)
	setStage(player, profile.stage)
	startRun(player, profile.stage == 1)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

local function onPlayerRemoving(player: Player)
	Coop.onPlayerRemoving(player)
	local profile = profiles[player]
	if profile then
		Data.save(player.UserId, profile)
		profiles[player] = nil
	end
end

-- نقاط الحفظ
for stage, pad in course.checkpointPads do
	pad.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local profile = player and profiles[player]
		if not player or not profile or Coop.isTeamed(player) then
			return
		end
		-- نسمح بس بالتقدّم، ما نرجّعه لورا
		if stage > profile.stage and profile.stage < Config.FinishedStage then
			setStage(player, stage)
		end
	end)
end

-- النهاية
course.finishPad.Touched:Connect(function(hit)
	local player = playerFromHit(hit)
	local profile = player and profiles[player]
	if not player or not profile or profile.stage ~= Config.FinalStage or Coop.isTeamed(player) then
		return
	end
	local elapsed = Workspace:GetServerTimeNow() - (player:GetAttribute("RunStart") or Workspace:GetServerTimeNow())
	local fullRun = player:GetAttribute("FullRun") == true
	local newBest = false
	if fullRun and (profile.best == nil or elapsed < profile.best) then
		profile.best = elapsed
		newBest = true
		player:SetAttribute("BestTime", elapsed)
	end
	profile.wins += 1
	player:SetAttribute("Wins", profile.wins)
	local stats = player:FindFirstChild("leaderstats")
	local winsValue = stats and stats:FindFirstChild(WINS_STAT)
	if winsValue and winsValue:IsA("IntValue") then
		winsValue.Value = profile.wins
	end
	setStage(player, Config.FinishedStage)

	notifyRemote:FireClient(player, {
		kind = "win",
		time = elapsed,
		fullRun = fullRun,
		best = profile.best,
		newBest = newBest,
		wins = profile.wins,
	})
	local text = if fullRun
		then string.format("🏆 %s خلّص أوبي المقلوب بوقت %s!", player.DisplayName, Format.time(elapsed))
		else string.format("🏆 %s خلّص أوبي المقلوب!", player.DisplayName)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			notifyRemote:FireClient(other, { kind = "message", text = text })
		end
	end
end)

-- ابدأ من جديد
local lastRestart: { [Player]: number } = {}
restartRemote.OnServerEvent:Connect(function(player)
	if not profiles[player] or Coop.isTeamed(player) then
		return
	end
	local now = os.clock()
	if lastRestart[player] and now - lastRestart[player] < 2 then
		return
	end
	lastRestart[player] = now
	setStage(player, 1)
	startRun(player, true)
	player:LoadCharacter()
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	onPlayerRemoving(player)
	lastRestart[player] = nil
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- حفظ تلقائي
task.spawn(function()
	while true do
		task.wait(Config.AutosaveSeconds)
		for player, profile in profiles do
			Data.save(player.UserId, profile)
		end
	end
end)

game:BindToClose(function()
	for player, profile in profiles do
		Data.save(player.UserId, profile)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="13">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- الواجهة: المرحلة والعالم، المؤقت، لافتة العالم الجديد، زر البداية، وشاشة الفوز
-- وفي الوضع التعاوني 🪢: اسم خويك، مراحل درب الحبل، وزر فك الحبل

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local restartRemote = remotes:WaitForChild("Restart") :: RemoteEvent
local notifyRemote = remotes:WaitForChild("Notify") :: RemoteEvent
local coopLeaveRemote = remotes:WaitForChild("CoopLeave") :: RemoteEvent
local coopRestartRemote = remotes:WaitForChild("CoopRestart") :: RemoteEvent

local CoopConfig = Config.Coop
local FONT = Enum.Font.GothamBold
local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(20, 20, 30)
local SUBTLE = Color3.fromRGB(210, 210, 225)
local GOLD = Color3.fromRGB(255, 220, 80)
local PING = "rbxasset://sounds/electronicpingshort.wav"

-- ========== أدوات صغيرة ==========

local function corner(parent: GuiObject, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function stroke(parent: GuiObject, color: Color3, thickness: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function textStroke(parent: TextLabel, thickness: number): UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = DARK
	s.Parent = parent
	return s
end

local function label(parent: Instance, text: string, size: UDim2, position: UDim2, textColor: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = position
	l.Text = text
	l.TextScaled = true
	l.Font = FONT
	l.TextColor3 = textColor or WHITE
	l.Parent = parent
	return l
end

local function button(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = position
	b.BackgroundColor3 = color
	b.Text = text
	b.TextScaled = true
	b.Font = FONT
	b.TextColor3 = WHITE
	b.AutoButtonColor = true
	b.Parent = parent
	corner(b, 12)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = b
	return b
end

local function playSound(id: string, volume: number)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.Parent = SoundService
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
end

local function partnerName(): string?
	local id = player:GetAttribute("Partner")
	if type(id) ~= "number" then
		return nil
	end
	local partner = Players:GetPlayerByUserId(id)
	return if partner then partner.DisplayName else "خويك"
end

local function isCoop(): boolean
	return type(player:GetAttribute("Partner")) == "number"
end

-- ========== الشاشة ==========

local gui = Instance.new("ScreenGui")
gui.Name = "ObbyHud"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

-- لوحة فوق: العالم والمرحلة
local top = Instance.new("Frame")
top.AnchorPoint = Vector2.new(0.5, 0)
top.Position = UDim2.new(0.5, 0, 0, 8)
top.Size = UDim2.new(0.5, 0, 0, 78)
top.BackgroundColor3 = DARK
top.BackgroundTransparency = 0.25
top.Parent = gui
corner(top, 14)
local topLimit = Instance.new("UISizeConstraint")
topLimit.MinSize = Vector2.new(260, 78)
topLimit.MaxSize = Vector2.new(460, 78)
topLimit.Parent = top

local worldLabel = label(top, "", UDim2.new(1, -16, 0, 30), UDim2.fromOffset(8, 6))
local descLabel = label(top, "", UDim2.new(1, -16, 0, 18), UDim2.fromOffset(8, 36), SUBTLE)
local timerLabel = label(top, "", UDim2.new(1, -16, 0, 16), UDim2.fromOffset(8, 56), Color3.fromRGB(255, 220, 120))

-- شريط التقدّم تحت اللوحة
local progressBack = Instance.new("Frame")
progressBack.AnchorPoint = Vector2.new(0.5, 0)
progressBack.Position = UDim2.new(0.5, 0, 0, 90)
progressBack.Size = UDim2.new(0.5, 0, 0, 8)
progressBack.BackgroundColor3 = DARK
progressBack.BackgroundTransparency = 0.3
progressBack.Parent = gui
corner(progressBack, 4)
local progressLimit = Instance.new("UISizeConstraint")
progressLimit.MinSize = Vector2.new(260, 8)
progressLimit.MaxSize = Vector2.new(460, 8)
progressLimit.Parent = progressBack
local progressFill = Instance.new("Frame")
progressFill.Size = UDim2.fromScale(0, 1)
progressFill.BackgroundColor3 = Color3.fromRGB(90, 255, 130)
progressFill.Parent = progressBack
corner(progressFill, 4)

-- لافتة كبيرة بالنص
local banner = Instance.new("Frame")
banner.AnchorPoint = Vector2.new(0.5, 0.5)
banner.Position = UDim2.fromScale(0.5, 0.35)
banner.Size = UDim2.fromScale(0.7, 0.18)
banner.BackgroundTransparency = 1
banner.Visible = false
banner.Parent = gui
local bannerTitle = label(banner, "", UDim2.fromScale(1, 0.62), UDim2.fromScale(0, 0))
bannerTitle.Font = Enum.Font.GothamBlack
textStroke(bannerTitle, 3)
local bannerDesc = label(banner, "", UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 0.66))
textStroke(bannerDesc, 2)

-- رسالة صغيرة (نقطة حفظ / أخبار)
local toast = label(gui, "", UDim2.new(0.6, 0, 0, 34), UDim2.new(0.2, 0, 0, 108), WHITE)
toast.TextTransparency = 1
local toastStroke = textStroke(toast, 2)
toastStroke.Transparency = 1

-- زر "من البداية" (عادي) وزر "فك الحبل" (تعاوني) بنفس المكان
local restartButton = button(gui, "↩️ من البداية", UDim2.fromOffset(150, 46), UDim2.fromOffset(12, 8), Color3.fromRGB(70, 70, 90))
stroke(restartButton, WHITE, 1)
local leaveButton = button(gui, "✂️ فك الحبل", UDim2.fromOffset(150, 46), UDim2.fromOffset(12, 8), Color3.fromRGB(150, 80, 60))
stroke(leaveButton, WHITE, 1)
leaveButton.Visible = false

-- نافذة تأكيد
local confirm = Instance.new("Frame")
confirm.AnchorPoint = Vector2.new(0.5, 0.5)
confirm.Position = UDim2.fromScale(0.5, 0.5)
confirm.Size = UDim2.fromOffset(320, 170)
confirm.BackgroundColor3 = DARK
confirm.Visible = false
confirm.ZIndex = 5
confirm.Parent = gui
corner(confirm, 16)
stroke(confirm, GOLD, 2)
local confirmTitle = label(confirm, "", UDim2.new(1, -20, 0, 36), UDim2.fromOffset(10, 14))
local confirmDesc = label(confirm, "", UDim2.new(1, -20, 0, 22), UDim2.fromOffset(10, 54), SUBTLE)
local yesButton = button(confirm, "✅ إيه", UDim2.fromOffset(130, 46), UDim2.fromOffset(20, 106), Color3.fromRGB(60, 170, 90))
local noButton = button(confirm, "❌ لا", UDim2.fromOffset(130, 46), UDim2.fromOffset(170, 106), Color3.fromRGB(170, 60, 70))
local confirmAction: (() -> ())? = nil

local function askConfirm(title: string, desc: string, action: () -> ())
	confirmTitle.Text = title
	confirmDesc.Text = desc
	confirmAction = action
	confirm.Visible = true
end

-- شاشة الفوز
local winPanel = Instance.new("Frame")
winPanel.AnchorPoint = Vector2.new(0.5, 0.5)
winPanel.Position = UDim2.fromScale(0.5, 0.5)
winPanel.Size = UDim2.fromOffset(360, 260)
winPanel.BackgroundColor3 = DARK
winPanel.Visible = false
winPanel.Parent = gui
corner(winPanel, 18)
stroke(winPanel, Color3.fromRGB(255, 215, 80), 3)
local winTitle = label(winPanel, "", UDim2.new(1, -20, 0, 44), UDim2.fromOffset(10, 16), GOLD)
local winTime = label(winPanel, "", UDim2.new(1, -20, 0, 30), UDim2.fromOffset(10, 70))
local winLine1 = label(winPanel, "", UDim2.new(1, -20, 0, 24), UDim2.fromOffset(10, 106), SUBTLE)
local winLine2 = label(winPanel, "", UDim2.new(1, -20, 0, 24), UDim2.fromOffset(10, 136), SUBTLE)
local againButton = button(winPanel, "🔁 العب من جديد", UDim2.fromOffset(200, 50), UDim2.new(0.5, -100, 1, -70), Color3.fromRGB(60, 170, 90))
local winLeaveButton = button(winPanel, "✂️ فك الحبل", UDim2.fromOffset(150, 50), UDim2.new(0.5, 5, 1, -70), Color3.fromRGB(150, 80, 60))
winLeaveButton.Visible = false
local winIsCoop = false

local function showWin(coop: boolean, title: string, timeText: string, line1: string, line2: string)
	winIsCoop = coop
	winTitle.Text = title
	winTime.Text = timeText
	winLine1.Text = line1
	winLine2.Text = line2
	winLeaveButton.Visible = coop
	if coop then
		againButton.Size = UDim2.fromOffset(150, 50)
		againButton.Position = UDim2.new(0.5, -155, 1, -70)
	else
		againButton.Size = UDim2.fromOffset(200, 50)
		againButton.Position = UDim2.new(0.5, -100, 1, -70)
	end
	winPanel.Visible = true
	winPanel.Size = UDim2.fromOffset(180, 130)
	TweenService:Create(winPanel, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(360, 260) }):Play()
	playSound(PING, 1)
end

-- ========== التحديث ==========

local shownKey: string? = nil -- "solo:5" أو "coop:3"
local frozenTime: number? = nil -- الوقت النهائي بعد ما تخلّص

local function showToast(text: string)
	toast.Text = text
	toast.TextTransparency = 0
	toastStroke.Transparency = 0
	local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 2.2)
	TweenService:Create(toast, info, { TextTransparency = 1 }):Play()
	TweenService:Create(toastStroke, info, { Transparency = 1 }):Play()
end

local bannerToken = 0
local function showBanner(title: string, desc: string, color: Color3)
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color
	bannerDesc.Text = desc
	banner.Visible = true
	banner.Size = UDim2.fromScale(0.35, 0.09)
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromScale(0.7, 0.18) }):Play()
	task.delay(3.2, function()
		if bannerToken == token then
			banner.Visible = false
		end
	end)
end

local function setProgress(done: number)
	TweenService:Create(progressFill, TweenInfo.new(0.4), { Size = UDim2.fromScale(math.clamp(done, 0, 1), 1) }):Play()
end

local function updateSolo()
	local stage = player:GetAttribute("Stage") or 1
	local finished = stage >= Config.FinishedStage
	local worldIndex = Config.worldIndexForStage(math.min(stage, Config.FinalStage)) or 1
	local world = Config.Worlds[worldIndex]

	if finished then
		worldLabel.Text = "🏆 خلّصت كل العوالم!"
		descLabel.Text = "تقدر تلعب من جديد وتكسر وقتك"
		worldLabel.TextColor3 = GOLD
	else
		worldLabel.Text = string.format("%s %s — المرحلة %d / %d", world.icon, world.name, stage, Config.FinalStage)
		descLabel.Text = world.desc
		worldLabel.TextColor3 = world.colors[1]
	end
	setProgress((stage - 1) / Config.FinalStage)
	restartButton.Visible = stage > 1
	leaveButton.Visible = false

	local key = "solo:" .. stage
	if key == shownKey then
		return
	end
	local previous = shownKey
	shownKey = key
	if not finished then
		frozenTime = nil
		if winPanel.Visible and not winIsCoop then
			winPanel.Visible = false
		end
	end
	if finished then
		return
	end
	local previousStage = previous and tonumber(string.match(previous, "^solo:(%d+)$"))
	if previousStage and stage > previousStage then
		playSound(PING, 0.6)
		if Config.isWorldStart(stage) then
			showBanner(string.format("%s العالم %d: %s", world.icon, worldIndex, world.name), world.desc, world.colors[1])
		else
			showToast(string.format("✅ المرحلة %d!", stage))
		end
	elseif not previousStage then
		-- أول مرة (دخلت اللعبة أو رجعت من الوضع التعاوني)
		showBanner(string.format("%s %s", world.icon, world.name), world.desc, world.colors[1])
	end
end

local function updateCoop()
	local stage = player:GetAttribute("CoopStage")
	if type(stage) ~= "number" then
		stage = 1
	end
	local finished = stage >= CoopConfig.FinishedStage
	local name = partnerName() or "خويك"

	if finished then
		worldLabel.Text = "🪢🏆 خلّصتوا درب الحبل!"
		worldLabel.TextColor3 = GOLD
	else
		worldLabel.Text = string.format("%s %s — المرحلة %d / %d", CoopConfig.icon, CoopConfig.name, stage, CoopConfig.FinalStage)
		worldLabel.TextColor3 = CoopConfig.colors[1]
	end
	descLabel.Text = string.format("مربوط مع %s • اضغط E أو 🪢 عشان تسحبه", name)
	setProgress((stage - 1) / CoopConfig.FinalStage)
	restartButton.Visible = false
	leaveButton.Visible = true

	local key = "coop:" .. stage
	if key == shownKey then
		return
	end
	local previous = shownKey
	shownKey = key
	if not finished then
		frozenTime = nil
		if winPanel.Visible and winIsCoop then
			winPanel.Visible = false
		end
	end
	local previousStage = previous and tonumber(string.match(previous, "^coop:(%d+)$"))
	if not finished and previousStage and stage > previousStage then
		playSound(PING, 0.6)
		showToast(string.format("✅ المرحلة %d! انتو الثنين", stage))
	end
end

local function updateDisplay()
	if isCoop() then
		updateCoop()
	else
		if winPanel.Visible and winIsCoop then
			winPanel.Visible = false
		end
		updateSolo()
	end
end

for _, attribute in { "Stage", "CoopStage", "Partner" } do
	player:GetAttributeChangedSignal(attribute):Connect(updateDisplay)
end
updateDisplay()

-- المؤقت
task.spawn(function()
	while true do
		local coop = isCoop()
		local start = player:GetAttribute(if coop then "CoopStart" else "RunStart")
		if frozenTime then
			timerLabel.Text = "⏱️ " .. Format.time(frozenTime)
		elseif type(start) == "number" then
			local text = "⏱️ " .. Format.time(Workspace:GetServerTimeNow() - start)
			local best = player:GetAttribute("BestTime")
			if not coop and type(best) == "number" then
				text ..= "   🥇 " .. Format.time(best)
			end
			timerLabel.Text = text
		else
			timerLabel.Text = ""
		end
		task.wait(0.1)
	end
end)

-- الأزرار
restartButton.Activated:Connect(function()
	askConfirm("ترجع للمرحلة 1؟", "المؤقت يبدأ من جديد عشان تسجّل أفضل وقت", function()
		restartRemote:FireServer()
	end)
end)
leaveButton.Activated:Connect(function()
	askConfirm("تفك الحبل؟", "ترجعون الثنين للأوبي العادي", function()
		coopLeaveRemote:FireServer()
	end)
end)
noButton.Activated:Connect(function()
	confirm.Visible = false
	confirmAction = nil
end)
yesButton.Activated:Connect(function()
	confirm.Visible = false
	local action = confirmAction
	confirmAction = nil
	if action then
		action()
	end
end)
againButton.Activated:Connect(function()
	winPanel.Visible = false
	if winIsCoop then
		coopRestartRemote:FireServer()
	else
		restartRemote:FireServer()
	end
end)
winLeaveButton.Activated:Connect(function()
	winPanel.Visible = false
	coopLeaveRemote:FireServer()
end)

-- رسايل السيرفر
notifyRemote.OnClientEvent:Connect(function(data)
	if type(data) ~= "table" then
		return
	end
	if data.kind == "win" then
		frozenTime = data.time
		local best = if data.newBest
			then "🎉 رقم قياسي جديد!"
			elseif type(data.best) == "number" then "🥇 أفضل وقت: " .. Format.time(data.best)
			else ""
		showWin(
			false,
			"🏆 خلّصت أوبي المقلوب!",
			if data.fullRun then "⏱️ وقتك: " .. Format.time(data.time) else "⏱️ ما بدأت من المرحلة 1، فالوقت ما ينحسب",
			best,
			string.format("🏅 عدد مرات الفوز: %d", data.wins or 1)
		)
	elseif data.kind == "coopWin" then
		frozenTime = data.time
		showWin(
			true,
			"🪢🏆 خلّصتوا درب الحبل!",
			"⏱️ وقتكم: " .. Format.time(data.time),
			string.format("🤝 أنت و %s", tostring(data.partner or "خويك")),
			string.format("🪢 فوز تعاوني: %d", data.wins or 1)
		)
	elseif data.kind == "coopFormed" then
		shownKey = nil
		showBanner(
			string.format("🪢 انربطت مع %s!", tostring(data.partner or "خويك")),
			"لو واحد طاح الثنين يرجعون • E أو زر 🪢 يسحب الحبل",
			CoopConfig.colors[1]
		)
		playSound(PING, 0.8)
	elseif data.kind == "coopBroken" and type(data.text) == "string" then
		shownKey = nil
		showToast(data.text)
	elseif data.kind == "coopFall" then
		showToast(if data.self then "💥 طحت… ترجعون سوا!" else string.format("💥 %s طاح… ترجعون سوا!", tostring(data.name)))
	elseif data.kind == "message" and type(data.text) == "string" then
		showToast(data.text)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="14">
          <Properties>
            <string name="Name">Mechanics</string>
            <string name="Source"><![CDATA[-- جهة اللاعب: تحريك المنصات، الموت من الحمم، منصات القفز، وحركات كل عالم
-- (الجاذبية الخفيفة، التحكم المعكوس، الكاميرا المقلوبة، والوقت المعكوس)
-- وفي الوضع التعاوني 🪢: الحبل يسحبك لخويك، وزر "اسحب" يقصّر الحبل

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local CoopConfig = Config.Coop

-- ========== تتبّع الأشياء المتحركة ==========

local function track(tag: string): { BasePart }
	local list: { BasePart } = {}
	local function add(inst: Instance)
		if inst:IsA("BasePart") and not table.find(list, inst) then
			table.insert(list, inst)
		end
	end
	for _, inst in CollectionService:GetTagged(tag) do
		add(inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
		local i = table.find(list, inst :: any)
		if i then
			table.remove(list, i)
		end
	end)
	return list
end

local movers = track("Mover")
local spinners = track("Spinner")
local vanishers = track("Vanish")

local TAU = math.pi * 2

-- نستخدم وقت السيرفر عشان كل اللاعبين يشوفون المنصات بنفس المكان تقريباً
RunService.Stepped:Connect(function()
	local t = Workspace:GetServerTimeNow()

	for _, p in movers do
		local origin = p:GetAttribute("Origin")
		local offset = p:GetAttribute("Offset")
		local period = p:GetAttribute("Period")
		if typeof(origin) == "CFrame" and typeof(offset) == "Vector3" and type(period) == "number" then
			local phase = (t % period) / period * TAU
			local alpha = 0.5 - 0.5 * math.cos(phase)
			p.CFrame = origin + offset * alpha
			-- السرعة تخلي اللاعب يمشي مع المنصة بدل ما يزحلق
			p.AssemblyLinearVelocity = offset * (0.5 * math.sin(phase) * TAU / period)
		end
	end

	for _, p in spinners do
		local center = p:GetAttribute("Center")
		local speed = p:GetAttribute("Speed")
		local phase = p:GetAttribute("Phase") or 0
		if typeof(center) == "CFrame" and type(speed) == "number" then
			p.CFrame = center * CFrame.Angles(0, (t * speed) % TAU + phase, 0)
		end
	end

	for _, p in vanishers do
		local period = p:GetAttribute("Period")
		local offset = p:GetAttribute("Offset") or 0
		local visible = p:GetAttribute("Visible") or 0.7
		if type(period) == "number" then
			local f = ((t + offset) % period) / period
			local shown = f < visible
			local warning = shown and f > visible - 0.15
			p.CanCollide = shown
			p.Transparency = if not shown then 0.85 elseif warning then 0.5 else 0
		end
	end
end)

-- ========== الموت ومنصات القفز ==========

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

local lastLaunch = 0

local function kill(humanoid: Humanoid)
	if humanoid.Health > 0 then
		humanoid.Health = 0
	end
end

local function launch(root: BasePart, humanoid: Humanoid, pad: BasePart)
	local now = os.clock()
	if now - lastLaunch < 0.4 then
		return
	end
	lastLaunch = now
	local height = pad:GetAttribute("LaunchHeight") or 20
	local vy = math.sqrt(2 * Workspace.Gravity * height)
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
end

-- ========== الحبل 🪢 ==========

local function partnerRoot(): BasePart?
	local partnerId = player:GetAttribute("Partner")
	if type(partnerId) ~= "number" then
		return nil
	end
	local partner = Players:GetPlayerByUserId(partnerId)
	local character = partner and partner.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- كل لاعب يسحب نفسه لخويه لو ابتعد أكثر من طول الحبل
-- لو أنت واقف وخويك معلّق تحتك، أنت "ماسك" فتتسحب شوي بس
local function applyRope(root: BasePart, humanoid: Humanoid)
	local other = partnerRoot()
	if not other then
		return
	end
	local length = player:GetAttribute("RopeLength")
	if type(length) ~= "number" then
		length = CoopConfig.ropeLength
	end
	local delta = other.Position - root.Position
	local dist = delta.Magnitude
	if dist <= length or dist > CoopConfig.snapDistance then
		return
	end
	local dir = delta / dist
	local holding = humanoid.FloorMaterial ~= Enum.Material.Air and delta.Y < -2
	local strength = if holding then 0.2 else 1
	local target = math.min((dist - length) * CoopConfig.pullStrength, CoopConfig.maxPull) * strength
	local velocity = root.AssemblyLinearVelocity
	local along = velocity:Dot(dir)
	if along < target then
		root.AssemblyLinearVelocity = velocity + dir * (target - along)
	end
end

-- الحبل يتدلّى لما يكون مرخي
local function updateRopeSag(root: BasePart)
	local ropes = Workspace:FindFirstChild("Ropes")
	if not ropes then
		return
	end
	local length = player:GetAttribute("RopeLength")
	if type(length) ~= "number" then
		length = CoopConfig.ropeLength
	end
	for _, beam in ropes:GetChildren() do
		if beam:IsA("Beam") and beam.Attachment0 and beam.Attachment1 then
			local a0, a1 = beam.Attachment0, beam.Attachment1
			if a0.Parent == root or a1.Parent == root then
				local dist = (a0.WorldPosition - a1.WorldPosition).Magnitude
				local sag = math.clamp((length - dist) * 0.6, 0, 6)
				beam.CurveSize0 = sag
				beam.CurveSize1 = -sag
			end
		end
	end
end

local reelRemote: RemoteEvent? = nil
task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	reelRemote = remotes:WaitForChild("CoopReel") :: RemoteEvent
end)

local REEL_ACTION = "CoopReel"
local reelBound = false

local function onReel(_name: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
	if reelRemote then
		if state == Enum.UserInputState.Begin then
			reelRemote:FireServer(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			reelRemote:FireServer(false)
		end
	end
	return Enum.ContextActionResult.Sink
end

local function updateReelBinding()
	local teamed = type(player:GetAttribute("Partner")) == "number"
	if teamed and not reelBound then
		reelBound = true
		ContextActionService:BindAction(REEL_ACTION, onReel, true, Enum.KeyCode.E, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle(REEL_ACTION, "🪢 اسحب")
		ContextActionService:SetPosition(REEL_ACTION, UDim2.new(1, -170, 1, -150))
	elseif not teamed and reelBound then
		reelBound = false
		ContextActionService:UnbindAction(REEL_ACTION)
		if reelRemote then
			reelRemote:FireServer(false)
		end
	end
end

player:GetAttributeChangedSignal("Partner"):Connect(updateReelBinding)
updateReelBinding()

local function onCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart
	overlap.FilterDescendantsInstances = { character }

	humanoid.Touched:Connect(function(other: BasePart)
		if CollectionService:HasTag(other, "Kill") then
			kill(humanoid)
		elseif CollectionService:HasTag(other, "JumpPad") then
			launch(root, humanoid, other)
		end
	end)

	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not character.Parent or humanoid.Health <= 0 then
			connection:Disconnect()
			return
		end
		-- لو طاح تحت المسار
		if root.Position.Y < -5 then
			kill(humanoid)
			return
		end
		applyRope(root, humanoid)
		updateRopeSag(root)
		-- العصي اللي تدور ما تطلق Touched دايماً، فنفحصها بأنفسنا
		for _, bar in spinners do
			if (bar.Position - root.Position).Magnitude < bar.Size.X then
				if #Workspace:GetPartsInPart(bar, overlap) > 0 then
					kill(humanoid)
					return
				end
			end
		end
	end)
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

-- ========== حركات العوالم ==========

local controls = nil
task.spawn(function()
	local ok, result = pcall(function()
		local module = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		return module:GetControls()
	end)
	if ok then
		controls = result
	else
		warn("[Obby] ما لقيت التحكم:", result)
	end
end)

local sepia = Instance.new("ColorCorrectionEffect")
sepia.Name = "RewindTint"
sepia.Enabled = false
sepia.Saturation = -0.75
sepia.Contrast = 0.15
sepia.TintColor = Color3.fromRGB(255, 225, 185)
sepia.Parent = Lighting

local baseClock = Lighting.ClockTime
local currentTwist: string? = nil

local function unbind(name: string)
	pcall(function()
		RunService:UnbindFromRenderStep(name)
	end)
end

local function clearTwist()
	Workspace.Gravity = Config.DefaultGravity
	unbind("ObbyInvert")
	unbind("ObbyFlipCamera")
	sepia.Enabled = false
	Lighting.ClockTime = baseClock
end

local function applyTwist(twist: string)
	if twist == currentTwist then
		return
	end
	clearTwist()
	currentTwist = twist

	if twist == "lowGravity" then
		Workspace.Gravity = Config.LowGravity
		Lighting.ClockTime = 0 -- ليل عشان القمر
	elseif twist == "invert" then
		-- نشتغل بعد سكربت التحكم ونعكس اتجاه المشي
		RunService:BindToRenderStep("ObbyInvert", Enum.RenderPriority.Input.Value + 1, function()
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and controls then
				local move: Vector3 = controls:GetMoveVector()
				if move.Magnitude > 0 then
					humanoid:Move(-move, true)
				end
			end
		end)
	elseif twist == "flipCamera" then
		-- نلف الكاميرا 180 درجة بعد ما تتحدّث
		RunService:BindToRenderStep("ObbyFlipCamera", Enum.RenderPriority.Camera.Value + 1, function()
			local camera = Workspace.CurrentCamera
			if camera then
				camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, math.pi)
			end
		end)
	elseif twist == "rewind" then
		sepia.Enabled = true
	end
end

local function refresh()
	-- في الوضع التعاوني ما فيه حركات عوالم
	if type(player:GetAttribute("Partner")) == "number" then
		applyTwist("none")
		return
	end
	local stage = player:GetAttribute("Stage") or 1
	local worldIndex = Config.worldIndexForStage(stage)
	local world = worldIndex and Config.Worlds[worldIndex]
	applyTwist(if world then world.twist else "none")
end

player:GetAttributeChangedSignal("Stage"):Connect(refresh)
player:GetAttributeChangedSignal("Partner"):Connect(refresh)
refresh()

-- ========== تلوين نقاط الحفظ اللي وصلتها ==========

local REACHED = Color3.fromRGB(90, 255, 130)
local NOT_REACHED = Color3.fromRGB(235, 235, 235)

local function colorCheckpoint(pad: Instance, attribute: string)
	if not pad:IsA("BasePart") then
		return
	end
	local stage = player:GetAttribute(attribute)
	if type(stage) ~= "number" then
		stage = if attribute == "Stage" then 1 else 0
	end
	local padStage = pad:GetAttribute("Stage") or 0
	pad.Color = if padStage <= stage then REACHED else NOT_REACHED
end

-- نقاط الأوبي العادي تتبع Stage، ونقاط درب الحبل تتبع CoopStage
for tag, attribute in { Checkpoint = "Stage", CoopCheckpoint = "CoopStage" } do
	local function colorAll()
		for _, pad in CollectionService:GetTagged(tag) do
			colorCheckpoint(pad, attribute)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(pad)
		colorCheckpoint(pad, attribute)
	end)
	player:GetAttributeChangedSignal(attribute):Connect(colorAll)
	colorAll()
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="15">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>